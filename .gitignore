# Dipendenze
node_modules

# Output di build (Vercel lo rigenera)
dist

# Vercel
.vercel

# Strumenti locali / editor
.claude
CLAUDE.md
CLAUDE.local.md
.vscode
*.local
.DS_Store
Thumbs.db
.offline-markdown-preview/

# Artefatti rigenerabili
content/trivia/raw/_IMPORT_REPORT.md
public/zips
public/repo-tree.json
# Pacchetti di traduzione, uno per lingua: li rigenera scripts/build-i18n.mjs
# da translations.json (la fonte, quella sì versionata) a ogni build e dev.
src/app/i18n/generated


# Log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.env
.env.local

# Foto originali di MiMa: sono centinaia, pesano GB, e nel repo ci va solo la
# versione rimpicciolita che genera `npm run foto` (public/images/mima/).
# Il LEGGIMI.md invece sì, resta versionato: spiega cosa mettere qui dentro.
foto/**
!foto/*/
!foto/*/LEGGIMI.md

# Copie di sicurezza del libro dei donatori (scripts/sostieni-libro.mjs --reset).
# Dentro ci sono nomi e messaggi di persone: restano sul disco, non nel repo.
.backup-donatori-*.json
