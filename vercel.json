{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "redirects": [
    { "source": "/bio",         "has": [{ "type": "host", "value": "www.albertopecchini.it" }], "destination": "https://bio.albertopecchini.it",         "permanent": true },
    { "source": "/trivia",      "has": [{ "type": "host", "value": "www.albertopecchini.it" }], "destination": "https://trivia.albertopecchini.it",      "permanent": true },
    { "source": "/pcto",        "has": [{ "type": "host", "value": "www.albertopecchini.it" }], "destination": "https://pcto.albertopecchini.it",        "permanent": true },
    { "source": "/me-stesso",   "has": [{ "type": "host", "value": "www.albertopecchini.it" }], "destination": "https://me-stesso.albertopecchini.it",   "permanent": true },
    { "source": "/dubliners",   "has": [{ "type": "host", "value": "www.albertopecchini.it" }], "destination": "https://dubliners.albertopecchini.it",   "permanent": true },
    { "source": "/gattopardo",  "has": [{ "type": "host", "value": "www.albertopecchini.it" }], "destination": "https://gattopardo.albertopecchini.it",  "permanent": true },
    { "source": "/archivio",    "has": [{ "type": "host", "value": "www.albertopecchini.it" }], "destination": "https://archivio.albertopecchini.it",    "permanent": true },
    { "source": "/sostieni",    "has": [{ "type": "host", "value": "www.albertopecchini.it" }], "destination": "https://sostieni.albertopecchini.it",    "permanent": true },
    { "source": "/festa",       "has": [{ "type": "host", "value": "www.albertopecchini.it" }], "destination": "https://festa.albertopecchini.it",       "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://vitals.vercel-insights.com https://api.github.com https://github-contributions-api.jogruber.de https://api.open-meteo.com https://api.openverse.org https://commons.wikimedia.org https://*.wikipedia.org; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Accept-CH", "value": "Sec-CH-UA-Model, Sec-CH-UA-Platform, Sec-CH-UA-Platform-Version, Sec-CH-UA-Mobile" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!assets/).*)\\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|pdf|zip)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
