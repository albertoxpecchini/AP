# ─── Classifica live di Angoli (Supabase, piano gratuito) ───────────────────
# Copia questo file in ".env" (o ".env.local") e incolla i tuoi valori.
# Sono valori PUBBLICI lato client (anon key): non mettere qui chiavi segrete.
# Se lasci vuoto, la classifica funziona in modalità "solo locale" (localStorage).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ─── Festa · notifica email dei voti (Resend) ───────────────────────────────
# Chiave SEGRETA lato server (solo /api/notify e middleware dev). NON ha il
# prefisso VITE_ apposta: non deve finire nel bundle del client.
# Con dominio non verificato Resend invia SOLO all'indirizzo del titolare
# dell'account → registra Resend con pzkko@yahoo.com (o verifica albertopecchini.it).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Link tracciabili · /d/<id> (Supabase + cron autodelete 7g) ─────────────
# Chiave SEGRETA service_role di Supabase (bypassa RLS): serve alle funzioni
# /api/d e /api/cron-cleanup e allo script scripts/make-link.mjs. NON esporla
# mai al client (niente prefisso VITE_). Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Segreto del cron di pulizia. Vercel lo invia come "Authorization: Bearer ..."
# alla funzione /api/cron-cleanup. Mettine uno lungo e casuale (es. openssl rand -hex 24).
CRON_SECRET=metti_una_stringa_lunga_e_casuale
