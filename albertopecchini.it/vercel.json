{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node tools/pzkko/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "functions": { "api/live.js": { "maxDuration": 60 } },
  "redirects": [
    { "source": "/portfolio/rivalta-sul-mincio/", "destination": "/portfolio/rivaltasulmincio-it/", "permanent": true },
    { "source": "/portfolio/rivaltasulmincio.it", "destination": "/portfolio/rivaltasulmincio-it/", "permanent": true },
    { "source": "/unimore/informatica/:es(es-\\d+)/", "destination": "/unimore/informatica/blocco-1/:es/", "permanent": true },
    { "source": "/assistenza/", "destination": "https://www.bettercallpekko.it/", "permanent": false },
    { "source": "/contatti/assistenza/", "destination": "https://www.bettercallpekko.it/contact/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/.well-known/discord",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/email/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/api/email-ai",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(media|art)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    }
  ]
}
