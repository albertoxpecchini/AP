{
  // ──────────────────────────────────────────────────────────────────────────
  // FIX PRINCIPALE — "Commit & Push" che resta a caricare all'infinito.
  //
  // Causa reale: con il default `git.useEditorAsCommitInput: true`, se la
  // casella del messaggio nel pannello Source Control è vuota, al Commit VS
  // Code apre il file .git/COMMIT_EDITMSG in una scheda e RESTA IN ATTESA che
  // tu scriva il messaggio e prema il ✓ (Accept Commit Message). Finché non lo
  // fai, l'operazione gira a vuoto e sembra "bloccata", senza mai arrivare al
  // push.
  //
  // Mettendolo a false, VS Code usa direttamente il messaggio scritto nella
  // casella di Source Control e committa subito (niente editor in attesa).
  // → Ricordati comunque di scrivere il messaggio nella casella prima di
  //   premere "Commit & Push".
  // ──────────────────────────────────────────────────────────────────────────
  "git.useEditorAsCommitInput": false,

  // ──────────────────────────────────────────────────────────────────────────
  // Contorno: l'autenticazione la gestisce Git Credential Manager (che già
  // funziona dal terminale), non l'askpass interno di VS Code — così neanche
  // il push può restare appeso su un prompt che non compare.
  // ──────────────────────────────────────────────────────────────────────────
  "git.useIntegratedAskPass": false,
  "github.gitAuthentication": false,

  // Niente fetch automatico né dialog di conferma sul sync: altre attese inutili.
  "git.autofetch": false,
  "git.confirmSync": false
}
