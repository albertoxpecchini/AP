{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/albertopecchini.it" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "online",
      "detail": "i tre dev server (albertopecchini.it, bettercallpekko.it, pzkko.it) con gli indirizzi pubblici fissi — Ctrl+Alt+O",
      "type": "shell",
      "command": "npm run online",
      "options": { "cwd": "${workspaceFolder}/albertopecchini.it" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "online",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^online:",
          "endsPattern": "^\\s*pronti\\s*$"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": false, "clear": true }
    }
  ]
}
